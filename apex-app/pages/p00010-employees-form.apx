page 10 (
    name: Employees Form
    alias: EMPLOYEES-FORM
    title: Employees Form
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region employees-form (
        name: Employees Form
        type: form
        source {
            location: localDatabase
            tableName: EMPLOYEES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P10_DEPT_ID (
        type: selectList
        label {
            label: Dept Nmae
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @departments-dept-name
        }
        layout {
            sequence: 50
            region: @employees-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @employees-form
            column: DEPT_ID
            dataType: number
        }
    )

    pageItem P10_EMAIL (
        type: textField
        label {
            label: Email
            alignment: right
        }
        layout {
            sequence: 30
            region: @employees-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 40
        }
        source {
            formRegion: @employees-form
            column: EMAIL
            dataType: varchar2
        }
    )

    pageItem P10_EMP_ID (
        type: hidden
        layout {
            sequence: 10
            region: @employees-form
            slot: regionBody
        }
        source {
            formRegion: @employees-form
            column: EMP_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10_EMP_NAME (
        type: textField
        label {
            label: Emp Name
            alignment: right
        }
        layout {
            sequence: 20
            region: @employees-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @employees-form
            column: EMP_NAME
            dataType: varchar2
        }
    )

    pageItem P10_JOIN_DATE (
        type: datePicker
        label {
            label: Join Date
            alignment: left
        }
        layout {
            sequence: 70
            region: @employees-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            formatMask: DD-MM-YYYY
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @employees-form
            column: JOIN_DATE
            dataType: date
        }
        security {
            authorizationScheme: @is-hr-or-admin
        }
    )

    pageItem P10_MANAGER_ID (
        type: numberField
        label {
            label: Manager Id
            alignment: right
        }
        layout {
            sequence: 60
            region: @employees-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @employees-form
            column: MANAGER_ID
            dataType: number
        }
    )

    pageItem P10_PHONE (
        type: textField
        label {
            label: Phone
            alignment: right
        }
        layout {
            sequence: 40
            region: @employees-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @employees-form
            column: PHONE
            dataType: varchar2
        }
    )

    pageItem P10_STATUS (
        type: textField
        label {
            label: Status
            alignment: left
        }
        layout {
            sequence: 80
            region: @employees-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @employees-form
            column: STATUS
            dataType: varchar2
        }
        security {
            authorizationScheme: @admin-only
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P10_EMP_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10_EMP_ID
        }
        security {
            authorizationScheme: @admin-only
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10_EMP_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 29575016986312378502
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-employees-form (
        name: Initialize form Employees Form
        type: formInitialization
        formRegion: @employees-form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 29575016134501378501
        }
    )

    process process-form-employees-form (
        name: Process form Employees Form
        type: formAutoRowProcessing
        formRegion: @employees-form
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 29575016540955378501
        }
    )

)

