page 9 (
    name: Employees
    alias: EMPLOYEES
    title: Employees
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region employees (
        name: Employees
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT EMP_ID,
                       EMP_NAME,
                       EMAIL,
                       PHONE,
                       DEPT_ID,
                  
                       (SELECT m.EMP_NAME FROM EMPLOYEES m WHERE m.EMP_ID = EMPLOYEES.MANAGER_ID) AS MANAGER_NAME,
                       JOIN_DATE,
                       STATUS
                FROM EMPLOYEES
                WHERE (
                    GET_CURRENT_USER_ROLE() IN ('HR','ADMIN','MANAGER')
                    OR EMP_ID = GET_CURRENT_EMP_ID()
                );
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 29575020082495378781
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @MANAGER_NAME
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @APEX$LINK
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @EMP_ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @EMP_NAME
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @EMAIL
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @PHONE
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @DEPT_ID
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @JOIN_DATE
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @STATUS
                layout {
                    sequence: 9
                }
            )

        )

        column APEX$LINK (
            type: link
            heading {
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 10
                    items: {
                        P10_EMP_ID: \&EMP_ID.\
                    }
                    clearCache: 10
                    action: resetPagination
                }
                linkText: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            }
            source {
                type: none
            }
        )

        column DEPT_ID (
            type: selectList
            heading {
                heading: Dept Name
            }
            lov {
                type: sharedComponent
                lov: @departments-dept-name
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: DEPT_ID
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

        column EMAIL (
            type: textField
            heading {
                heading: Email
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
                maxLength: 40
            }
            source {
                databaseColumn: EMAIL
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column EMP_ID (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                databaseColumn: EMP_ID
                dataType: number
                queryOnly: true
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column EMP_NAME (
            type: textField
            heading {
                heading: Emp Name
            }
            layout {
                sequence: 30
            }
            validation {
                valueRequired: true
                maxLength: 30
            }
            source {
                databaseColumn: EMP_NAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column JOIN_DATE (
            type: datePicker
            heading {
                heading: Join Date
            }
            layout {
                sequence: 90
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: JOIN_DATE
                dataType: date
            }
        )

        column MANAGER_NAME (
            type: textField
            heading {
                heading: Manager Name
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: MANAGER_NAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column PHONE (
            type: textField
            heading {
                heading: Phone
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
                maxLength: 30
            }
            source {
                databaseColumn: PHONE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column STATUS (
            type: textField
            heading {
                heading: Status
            }
            layout {
                sequence: 100
            }
            validation {
                valueRequired: true
                maxLength: 30
            }
            source {
                databaseColumn: STATUS
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
            security {
                authorizationScheme: @is-hr-or-admin-or-manager
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @employees
            slot: edit
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
                clearCache: 10
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @employees
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @employees
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

