page 6 (
    name: Departments form
    alias: DEPARTMENTS-FORM
    title: Departments form
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region departments-form (
        name: Departments form
        type: form
        source {
            location: localDatabase
            tableName: DEPARTMENTS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P6_DEPT_ID (
        type: hidden
        layout {
            sequence: 10
            region: @departments-form
            slot: regionBody
        }
        source {
            formRegion: @departments-form
            column: DEPT_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P6_DEPT_NAME (
        type: textField
        label {
            label: Dept Name
            alignment: right
        }
        layout {
            sequence: 20
            region: @departments-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @departments-form
            column: DEPT_NAME
            dataType: varchar2
        }
    )

    pageItem P6_LOCATION (
        type: textField
        label {
            label: Location
            alignment: right
        }
        layout {
            sequence: 30
            region: @departments-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @departments-form
            column: LOCATION
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @departments-form
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 5
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @departments-form
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P6_DEPT_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @departments-form
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message:
                ```html
                &APP_TEXT$DELETE_MSG!RAW.
                Are you sure you want to delete this department? Any employees assigned to it will need to be reassigned.
                ```
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P6_DEPT_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @departments-form
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P6_DEPT_ID
        }
    )

    process initialize-form-departments-form (
        name: Initialize form Departments form
        type: formInitialization
        formRegion: @departments-form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 29570547738072056048
        }
    )

    process process-form-departments-form (
        name: Process form Departments form
        type: formAutoRowProcessing
        formRegion: @departments-form
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 29570548116952056048
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 5
            }
        }
    )

)

